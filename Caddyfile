:80 {
	root * /srv
	encode gzip zstd

	# Hashed build output: cache forever, and 404 when missing (no SPA fallback).
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Dictionary shards: cache for a week, and 404 when missing.
	handle /dict/* {
		header Cache-Control "public, max-age=604800"
		file_server
	}

	# Everything else (index.html, sw.js, client-side routes) must revalidate.
	handle {
		header Cache-Control "no-cache"
		try_files {path} {path}/ /index.html
		file_server
	}
}
