:80 {
	root * /srv
	encode gzip zstd

	# Vite content-hashes these filenames, so they can never go stale — but a
	# request for one that does NOT exist (renamed/pruned build artifact, a
	# stale Workbox precache entry) must 404, not fall through to index.html.
	# A `handle` block only runs `file_server`, with no `try_files` fallback,
	# so a miss here is a real 404. If it fell through instead, the missing
	# asset would come back 200 text/html under a long-lived immutable cache
	# header — cached by the service worker under that .js URL forever, with
	# the app then failing to parse HTML as JS/JSON and silently degrading.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# 128 dictionary shards, ~113 KB each. Worth caching hard — but same
	# reasoning as /assets: a miss must 404, never fall back to index.html.
	# `lookup.ts` checks `response.ok`, so a 200 HTML body reads as a
	# "successful" fetch, then fails to JSON-parse and degrades to no
	# suggestions — and the service worker's CacheFirst rule for /dict/*.json
	# has no time-based expiration, so that shard stays broken indefinitely,
	# even across a corrected deploy.
	#
	# The shard body is NOT content-stable: `meanings` is a structured field
	# (string[] before French support, { en?, fr? } after) and this URL
	# carries no version or hash, so a client with this response already
	# cached — here or in the service worker's runtime cache — keeps getting
	# served the old shape after a deploy changes it. `lookup.ts`'s loadShard
	# normalises on read for exactly that reason; do not treat a shard's JSON
	# shape as fixed just because the byte size is.
	handle /dict/* {
		header Cache-Control "public, max-age=604800"
		file_server
	}

	# Everything else must revalidate: the app shell, unhashed files (sw.js,
	# manifest.webmanifest, registerSW.js, icons), and every client-side route
	# (/stats, /deck/:id, /settings, ...). This is also the only block that may
	# use the SPA fallback (try_files ... /index.html) — it must NOT be shared
	# with the /assets or /dict blocks above, or a missing file under either of
	# those prefixes would silently become a 200 HTML response instead of a 404.
	handle {
		header Cache-Control "no-cache"
		try_files {path} {path}/ /index.html
		file_server
	}
}
